      "id": "2cfb6c2c-c7fe-46e6-ba8d-28efde18fa9c",
      "name": "Tag: SQL Error"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first()?.json || {};\nlet report = {};\n\ntry {\n  report = $(\"Get Report Definition\").first().json || {};\n} catch (e) {}\n\nlet errorMsg = \"Errore sconosciuto\";\nlet missingParams;\n\nif (item.__error && item.error) {\n  errorMsg = item.error;\n  missingParams = item.missingParams;\n} else if (item.error?.message) {\n  errorMsg = item.error.message;\n} else if (item.__source === \"report-not-found\") {\n  errorMsg = `Report non trovato: reportId=${item.reportId}`;\n} else if (item.__source === \"unsupported-database-type\") {\n  errorMsg = `Database type non supportato: ${item.database_type}`;\n} else if (item.__source === \"unknown-server\") {\n  errorMsg = `Server non configurato: ${item.server_name}`;\n} else if (item.__source === \"sql-error\") {\n  errorMsg = `Errore SQL: ${item.message || \"query fallita\"}`;\n}\n\nreturn [\n  {\n    json: {\n      success: false,\n      reportId: report.id ?? null,\n      reportName: report.report_name ?? null,\n      columns: [],\n      rowCount: 0,\n      data: [],\n      executedAt: new Date().toISOString(),\n      error: errorMsg,\n      ...(missingParams ? { missingParams } : {}),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        832
      ],
      "id": "3f619441-b6f1-48d7-940d-f9462aaf7476",
      "name": "Build Error Response"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst nonEmpty = rows.filter(r => r && Object.keys(r).length > 0);\n\nlet report = {};\n\ntry {\n  report = $(\"Get Report Definition\").first().json || {};\n} catch (e) {}\n\nconst columns = nonEmpty.length > 0 ? Object.keys(nonEmpty[0]) : [];\n\nreturn [\n  {\n    json: {\n      success: true,\n      reportId: report.id ?? null,\n      reportName: report.report_name ?? null,\n      columns,\n      rowCount: nonEmpty.length,\n      data: nonEmpty,\n      executedAt: new Date().toISOString(),\n      error: null,\n    },\n  },\n];"
      },
