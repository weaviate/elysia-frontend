    {
      "parameters": {
        "jsCode": "const report = $input.first().json;    \nconst webhookData = $('Webhook').first().json.body || $('Webhook').first().json;  \nconst params = { ...(webhookData.params || {}) };                                     \nconst outputFormat = webhookData.output || 'json';\nif (!params.p_fte) params.p_fte = '%';                      \n  let query = report.main_query || '';                                                    \n  const placeholderRegex = /\\$\\{([^}]+)\\}/g;                  \n  const foundPlaceholders = [...query.matchAll(placeholderRegex)].map(m => m[1]);       \n  const missing = foundPlaceholders.filter(p => params[p] === undefined || params[p] === null);     \nif (missing.length > 0) {                                                             \n    return [{ json: {                \n      __error: true,                                        error: `PARAMETRI MANCANTI: ${missing.join(', ')}`,     missingParams: missing,                               report\n    }}];                                                                                \n  }        \n  const finalQuery = query.replace(placeholderRegex, (match, paramName) => {            \n    const value = params[paramName];\n    const escaped = String(value).replace(/'/g, \"''\");                                  \n    return `'${escaped}'`;                                                              \n  });    \n  return [{ json: {                                                                       \n    ...report,                       \n    finalQuery,\n    originalQuery: query,                                                               \n    params,\n    outputFormat,                                                                       \n    database_type: report.database_type,                                                  \n    server_name: report.server_name,                                                    \n    database_name: report.database_name\n  }}];"
      },
